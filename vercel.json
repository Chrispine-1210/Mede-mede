{
    "buildCommand": "npm run build",
    "outputDirectory": "dist/client",
    "framework": "nextjs",
    "nodeVersion": "18.x",
    "rewrites": [
    {
        "source": "/api/(.*)",
        "destination": "/api/$1"
    },
    {
        "source": "/(.*)",
        "destination": "/index.html"
    }
    ]
}
